[Unit]
Description=Read-only public HTTPS, DNS and TLS security controls
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/onestack-security/monitor.py availability --config /etc/onestack-security/policy.json --output /var/lib/onestack-security
TimeoutStartSec=15min
Nice=15
CPUQuota=30%
MemoryMax=512M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/onestack-security
PrivateTmp=true
UMask=0077
