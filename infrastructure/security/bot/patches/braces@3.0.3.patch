@@ -0,0 +1,22 @@
+'use strict';
+
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0, exit: false }];
+  const ancestors = new Set();
+  let count = 0;
+  while (pending.length) {
+    const item = pending.pop();
+    if (!item.node || typeof item.node !== 'object') continue;
+    if (item.exit) { ancestors.delete(item.node); continue; }
+    if (item.depth > 128 || ancestors.has(item.node) || ++count > 100000) {
+      throw new SyntaxError('Brace pattern exceeds security depth or node limit');
+    }
+    ancestors.add(item.node);
+    pending.push({ node: item.node, depth: item.depth, exit: true });
+    if (Array.isArray(item.node.nodes)) {
+      for (let i = item.node.nodes.length - 1; i >= 0; i--) {
+        pending.push({ node: item.node.nodes[i], depth: item.depth + 1, exit: false });
+      }
+    }
+  }
+};
